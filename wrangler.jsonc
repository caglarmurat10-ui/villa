{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "villa-yonetim",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "META_APP_ID": "2566616200453545",
    "APP_BASE_URL": "https://villa-yonetim.caglarmurat10.workers.dev"
  },
  "secrets": {
    "required": ["META_APP_SECRET"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "villa-yonetim", "database_id": "fa8fc6ec-9cc5-4c92-ba04-b23f2a9b8106" }
  ],
  "kv_namespaces": [
    { "binding": "SOCIAL_MEDIA_KV", "id": "aee4775e7d0c4d9b9b488297bb4736be" }
  ],
  "observability": { "enabled": true }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "villa-yonetim",
  "main": "./worker.ts",
  "keep_vars": true,
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "META_APP_ID": "2566616200453545",
    "APP_BASE_URL": "https://villa-yonetim.caglarmurat10.workers.dev",
    "OPENAI_TEXT_MODEL": "gpt-5.6-terra",
    "OPENAI_IMAGE_MODEL": "gpt-image-2",
    "AI_IMAGE_ENABLED": "false",
    "AI_VIDEO_ENABLED": "false"
  },
  "secrets": {
    "required": ["META_APP_SECRET", "OPENAI_API_KEY", "PEXELS_API_KEY", "SOCIAL_AI_ADMIN_KEY"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "villa-yonetim", "database_id": "fa8fc6ec-9cc5-4c92-ba04-b23f2a9b8106", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "SOCIAL_MEDIA_KV", "id": "aee4775e7d0c4d9b9b488297bb4736be" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}

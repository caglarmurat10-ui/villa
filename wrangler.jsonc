{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "villa-yonetim",
  "main": "./custom-worker.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [
    { "pattern": "safiradestan.com", "custom_domain": true },
    { "pattern": "www.safiradestan.com", "custom_domain": true },
    { "pattern": "admin.safiradestan.com", "custom_domain": true }
  ],
  "vars": {
    "META_APP_ID": "2566616200453545",
    "FACEBOOK_APP_ID": "2333943650679330",
    "FACEBOOK_CONFIG_ID": "1095389230103732",
    "APP_BASE_URL": "https://admin.safiradestan.com",
    "INSTAGRAM_OAUTH_BASE_URL": "https://admin.safiradestan.com",
    "SOCIAL_AUTO_PUBLISH_ENABLED": "false",
    "SOCIAL_AUTO_PUBLISH_TIME": "12:00",
    "SOCIAL_AUTO_PUBLISH_LIMIT": "2"
  },
  "secrets": {
    "required": ["META_APP_SECRET", "FACEBOOK_APP_SECRET"]
  },
  "kv_namespaces": [
    { "binding": "META_PRIVATE" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "villa-yonetim", "database_id": "fa8fc6ec-9cc5-4c92-ba04-b23f2a9b8106" }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": { "enabled": true }
}

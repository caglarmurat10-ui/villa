{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "villa-yonetim",
  "main": "./custom-worker.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [
    { "pattern": "safiradestan.com", "custom_domain": true },
    { "pattern": "www.safiradestan.com", "custom_domain": true },
    { "pattern": "admin.safiradestan.com", "custom_domain": true }
  ],
  "vars": {
    "META_APP_ID": "2566616200453545",
    "FACEBOOK_APP_ID": "2333943650679330",
    "FACEBOOK_CONFIG_ID": "1095389230103732",
    "APP_BASE_URL": "https://admin.safiradestan.com",
    "INSTAGRAM_OAUTH_BASE_URL": "https://admin.safiradestan.com",
    "SOCIAL_AUTO_PUBLISH_ENABLED": "true",
    "SOCIAL_AUTO_PUBLISH_TIME": "12:00",
    "SOCIAL_AUTO_PUBLISH_LIMIT": "2"
  },
  // NOT: PAYTR_MERCHANT_ID/KEY/SALT bilerek "required" listesine EKLENMEDİ - bu liste wrangler'da
  // salt bir uyarı değil, sağlanmadan deploy'u tamamen ENGELLEYEN sert bir kapı (canlı test edildi:
  // deploy "required secrets have not been set" hatasıyla durdu). PayTR entegrasyonu tasarım gereği
  // bu üç secret olmadan da deploy edilebilir/dormant kalabilir olmalı - o yüzden bu liste değişmedi.
  // Gerçek secret isimleri src/lib/payments/paytr/config.ts'te ve final raporda dokümante edilmiştir.
  "secrets": {
    "required": [
      "META_APP_SECRET",
      "FACEBOOK_APP_SECRET",
      "ADMIN_PASSWORD",
      "ADMIN_SESSION_SECRET"
    ]
  },
  "kv_namespaces": [
    { "binding": "META_PRIVATE" },
    { "binding": "OTA_PRIVATE", "id": "9d1b206b16604753996c73a218773802" },
    { "binding": "GOOGLE_PRIVATE", "id": "cd02a392208f4835ab3b84fd679f8464" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "villa-yonetim", "database_id": "fa8fc6ec-9cc5-4c92-ba04-b23f2a9b8106" }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // "0 3 * * *" - günlük sosyal planlayıcı (ensureRolling30DayPlan), yayın-kritik */15 cron'undan
  // BİLEREK ayrı bir invocation'da çalışır (bkz. custom-worker.mjs scheduled() - Error 1102 sonrası
  // kaynak izolasyonu). 03:00 UTC = 06:00 İstanbul, düşük trafik saati.
  "triggers": {
    "crons": ["*/15 * * * *", "*/30 * * * *", "0 3 * * *"]
  },
  "observability": { "enabled": true }
}
